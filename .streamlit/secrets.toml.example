# Copy this file to .streamlit/secrets.toml for a local Supabase-backed run.
# Paste its populated contents into Streamlit Community Cloud → App settings → Secrets.
# Never commit real credentials. .streamlit/secrets.toml is gitignored.

VENDORFLOW_STORAGE_BACKEND = "supabase"
SUPABASE_URL = "https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY = "replace-with-your-server-side-service-role-key"
SUPABASE_DB_URL = "postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require"
SUPABASE_STORAGE_BUCKET = "vendor-documents"

# Demonstration-only admin gate. Choose your own value and keep it private.
VENDORFLOW_ADMIN_PASSWORD = "replace-with-a-strong-demo-password"
VENDORFLOW_MAX_UPLOAD_MB = 10
VENDORFLOW_ENABLE_AI = false

# Optional AI extraction. Leave disabled unless you intentionally configure an API key.
# OPENAI_API_KEY = ""
# OPENAI_MODEL = "gpt-4o-mini"
