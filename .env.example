# Local database and file storage
VENDORFLOW_DB_PATH=data/vendorflow.db
VENDORFLOW_DATA_DIR=data
VENDORFLOW_MAX_UPLOAD_MB=10

# Demonstration-only admin login. Change it before sharing a private demo.
VENDORFLOW_ADMIN_PASSWORD=change-this-demo-password

# Optional AI document interpretation. Disabled unless explicitly enabled.
# When enabled, candidate values are stored only if their exact text appears in the source PDF.
VENDORFLOW_ENABLE_AI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
